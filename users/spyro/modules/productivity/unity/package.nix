{ pkgs, lib }:

let
  # ---------------------------------------------------------------------------
  # unity-cli — a self-contained, store-pinned package for the official Unity
  # CLI plus the NixOS support that makes the in-place Unity Editor runnable.
  #
  # The CLI is a single pre-built C# Native AOT binary, dynamically linked
  # against glibc + libgcc and built outside Nix. NixOS stubs
  # /lib64/ld-linux-x86-64.so.2, so a bare store copy cannot run: the binary is
  # patchelf'd to the store's glibc + libgcc (fixupPhase below).
  #
  # Pinned to a specific version + sha256 (this reverses the old bootstrap +
  # `unity self-update` model — see docs/adr/0003-unity-cli-replaces-hub.md).
  # To update: bump `version` and `sha256` (from
  # https://public-cdn.cloud.unity3d.com/hub/prod/cli/latest-beta.json) and
  # rebuild.
  #
  # The package also carries the Editor support, so it is one cohesive unit:
  #   bin/unity                  the CLI (patchelf'd to the store glibc)
  #   bin/unity-editor           the Editor launcher (runtime env + discovery)
  #   bin/unity-editor-patchelf  idempotent patchelf of the in-place Editor
  #   lib/unity-editor-libs/     symlinks to the system libs the Editor needs
  #
  # Host-agnostic by design: the Editor version and the active NVIDIA Vulkan
  # ICD are DISCOVERED AT RUNTIME (the Editor is installed in-place by the CLI,
  # and the driver is a system-level package), so nothing host-specific is
  # baked into this package. The only pinned values are the CLI version/sha256
  # and the nixpkgs system libs (which are not host-specific).
  # ---------------------------------------------------------------------------

  version = "1.0.0-beta.14";
  sha256 = "d9a2c1716ce723b970898f7f40adc09cceee04e84ce2f1f1638f07ac3e9898aa";

  # The 64-bit system libs the Editor's binaries and .so files need, as
  # (symlink-name, store-path) pairs. All nixpkgs packages — resolved at build
  # time, not host-specific.
  unityLibs = [
    { name = "libGL.so.1"; src = "${pkgs.libglvnd}/lib/libGL.so.1"; }
    { name = "libX11.so.6"; src = "${pkgs.libx11}/lib/libX11.so.6"; }
    { name = "libXcursor.so.1"; src = "${pkgs.libxcursor}/lib/libXcursor.so.1"; }
    { name = "libXrandr.so.2"; src = "${pkgs.libxrandr}/lib/libXrandr.so.2"; }
    { name = "libatk-1.0.so.0"; src = "${pkgs.at-spi2-core}/lib/libatk-1.0.so.0"; }
    { name = "libcairo.so.2"; src = "${pkgs.cairo}/lib/libcairo.so.2"; }
    { name = "libcairo-gobject.so.2"; src = "${pkgs.cairo}/lib/libcairo-gobject.so.2"; }
    { name = "libcrypto.so"; src = "${pkgs.openssl}/lib/libcrypto.so"; }
    { name = "libcrypto.so.3"; src = "${pkgs.openssl}/lib/libcrypto.so.3"; }
    { name = "libfontconfig.so.1"; src = "${pkgs.fontconfig}/lib/libfontconfig.so.1"; }
    { name = "libgdk-3.so.0"; src = "${pkgs.gtk3}/lib/libgdk-3.so.0"; }
    { name = "libgdk_pixbuf-2.0.so.0"; src = "${pkgs.gdk-pixbuf}/lib/libgdk_pixbuf-2.0.so.0"; }
    { name = "libgio-2.0.so.0"; src = "${pkgs.glib}/lib/libgio-2.0.so.0"; }
    { name = "libglib-2.0.so.0"; src = "${pkgs.glib}/lib/libglib-2.0.so.0"; }
    { name = "libgobject-2.0.so.0"; src = "${pkgs.glib}/lib/libgobject-2.0.so.0"; }
    { name = "libgtk-3.so.0"; src = "${pkgs.gtk3}/lib/libgtk-3.so.0"; }
    { name = "libharfbuzz.so.0"; src = "${pkgs.harfbuzz}/lib/libharfbuzz.so.0"; }
    { name = "libicui18n.so.76"; src = "${pkgs.icu}/lib/libicui18n.so.76"; }
    { name = "libicuuc.so.76"; src = "${pkgs.icu}/lib/libicuuc.so.76"; }
    { name = "libpango-1.0.so.0"; src = "${pkgs.pango}/lib/libpango-1.0.so.0"; }
    { name = "libpangocairo-1.0.so.0"; src = "${pkgs.pango}/lib/libpangocairo-1.0.so.0"; }
    { name = "libssl.so"; src = "${pkgs.openssl}/lib/libssl.so"; }
    { name = "libssl.so.3"; src = "${pkgs.openssl}/lib/libssl.so.3"; }
    { name = "libstdc++.so.6"; src = "${pkgs.gcc.cc.lib}/lib/libstdc++.so.6"; }
    { name = "libudev.so.1"; src = "${pkgs.systemd}/lib/libudev.so.1"; }
    { name = "libvulkan.so.1"; src = "${pkgs.vulkan-loader}/lib/libvulkan.so.1"; }
    { name = "libxml2.so.2"; src = "${pkgs.libxml2}/lib/libxml2.so.2"; }
    { name = "libz.so.1"; src = "${pkgs.zlib}/lib/libz.so.1"; }
  ];

  # The launcher: sets up the runtime environment and execs the Editor
  # directly (its interpreter is patchelf'd to the store glibc, so it runs
  # without going through ld.so — Unity derives its base path from
  # /proc/self/exe, which resolves wrong when invoked via the linker).
  #
  # Host-agnostic: the Editor dir and the active NVIDIA Vulkan ICD are
  # discovered at runtime, so no host-specific path is baked in.
  unityEditorLauncher = pkgs.writeShellScript "unity-editor" ''
    #!/usr/bin/env bash
    # unity-editor — launch the Unity Editor on NixOS.
    # Generated by the unity package; do not edit by hand.
    #
    # The Editor (installed in-place by the `unity` CLI) is a generic-Linux
    # dynamically-linked binary. NixOS stubs /lib64/ld-linux-x86-64.so.2, so it
    # cannot start out of the box. Its interpreter + RPATH are patchelf'd to the
    # store glibc and the package's lib/unity-editor-libs symlink dir (applied
    # on activation by unity-editor-patchelf), and this launcher sets the
    # runtime environment.
    set -euo pipefail

    # The system-libs symlink dir that ships in this package (the
    # __UNITY_EDITOR_LIBS__ placeholder is replaced with the real store path at
    # build time, so the launcher is self-contained).
    LIBDIR="__UNITY_EDITOR_LIBS__"

    # Discover the Editor (newest version wins). The Editor is installed
    # in-place by the `unity` CLI, so its version is not known at build time.
    EDITOR_DIR=""
    for d in "$HOME"/Unity/Hub/Editor/*/Editor; do
      [ -d "$d" ] && EDITOR_DIR="$d"
    done
    if [ -z "$EDITOR_DIR" ]; then
      echo "unity-editor: no Unity Editor found under \$HOME/Unity/Hub/Editor — install one with 'unity install'" >&2
      exit 1
    fi

    if [ ! -d "$LIBDIR" ]; then
      echo "unity-editor: $LIBDIR missing — run 'config build two-b' to apply the NixOS setup" >&2
      exit 1
    fi

    # Editor's own libs + the system libs (via the symlink dir).
    export LD_LIBRARY_PATH="''${EDITOR_DIR}:''${LIBDIR}''${LD_LIBRARY_PATH:+:''${LD_LIBRARY_PATH}}"
    export DISPLAY="''${DISPLAY:-:0}"
    export XAUTHORITY="''${XAUTHORITY:-/run/user/$(id -u)/xauth_*}"
    # The system is Wayland (sddm). Without WAYLAND_DISPLAY the Editor can't
    # find the socket and falls back to X11, which it then fails to use
    # ("Selected window backend: (null)").
    export WAYLAND_DISPLAY="''${WAYLAND_DISPLAY:-wayland-1}"
    # The Editor's .NET sub-processes need ICU for globalization. CoreCLR's ICU
    # loader doesn't reliably pick it up from RPATH here, so run .NET in
    # invariant globalization mode (no ICU required).
    export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1

    # The Editor loads libvulkan.so.1 from $LIBDIR; that loader must then find
    # the NVIDIA ICD to create a Vulkan device. The NixOS loader's default ICD
    # search path does not reliably include the active driver's ICD, so point it
    # at the ICD JSON explicitly. The active driver version is read from
    # /proc/driver/nvidia and the matching store ICD is discovered at runtime —
    # no host-specific path is baked in.
    if [ -z "''${VK_ICD_FILENAMES:-}" ]; then
      # The active driver version is the first N.N.N token on the NVRM line
      # (its position varies, so match the pattern rather than a fixed field).
      drv_ver="$(awk '/NVRM version/ {for(i=1;i<=NF;i++) if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+$/) {print $i; exit}}' /proc/driver/nvidia/version 2>/dev/null || true)"
      if [ -n "$drv_ver" ]; then
        icd="$(ls -1 /nix/store/*-nvidia-x11-"$drv_ver"/share/vulkan/icd.d/nvidia_icd.json 2>/dev/null | head -1 || true)"
        [ -n "$icd" ] && export VK_ICD_FILENAMES="$icd"
      fi
    fi

    exec "$EDITOR_DIR/Unity" "$@"
  '';

  # The patchelf: make the Editor's sub-binaries and .so files runnable on
  # NixOS. Idempotent — binaries already pointing at the store glibc are
  # skipped (their RPATH is refreshed), and .so files whose RPATH already
  # includes the libs dir are skipped.
  #
  # Host-agnostic: the Editor dir is discovered at runtime (newest version
  # wins), and the libs dir is the package's own lib/unity-editor-libs.
  unityEditorPatchelf = pkgs.writeShellScript "unity-editor-patchelf" ''
    #!/usr/bin/env bash
    # unity-editor-patchelf — make the in-place Unity Editor runnable on NixOS.
    # Generated by the unity package; run on activation (idempotent).
    #
    # Two passes:
    #   1. Executables: set the interpreter to the store glibc linker + RPATH to
    #      (original rpath, preserved from the .orig backup) + the libs dir.
    #   2. .so files: set the RPATH to (original rpath) + the libs dir. The
    #      Editor launches .NET subprocesses WITHOUT LD_LIBRARY_PATH, and the
    #      .NET runtime's .so files dlopen system libs (libssl, ICU) at runtime,
    #      so they need the RPATH too.
    set -euo pipefail
    PATCHELF="${pkgs.patchelf}/bin/patchelf"
    SYMLINK_DIR="__UNITY_EDITOR_LIBS__"
    GLIBC_LD="${pkgs.glibc}/lib/ld-linux-x86-64.so.2"

    # Discover the Editor (newest version wins). The Editor is installed
    # in-place by the `unity` CLI, so its version is not known at build time.
    EDITOR_DIR=""
    for d in "$HOME"/Unity/Hub/Editor/*/Editor; do
      [ -d "$d" ] && EDITOR_DIR="$d"
    done

    # Skip (with a warning, not an error) if the Editor isn't installed here —
    # the deploy must not fail on a host without the Editor.
    [ -n "$EDITOR_DIR" ] || { echo "unity-editor-patchelf: no Unity Editor under \$HOME/Unity/Hub/Editor — skipping" >&2; exit 0; }

    # New RPATH for a binary = its ORIGINAL rpath (preserved, so $ORIGIN-relative
    # paths like $ORIGIN/Data/Tools keep working) + the libs dir. Reading the
    # original rpath from the .orig backup avoids clobbering it.
    rpath_for() {
      local f="$1" orig=""
      if [ -f "$f.orig" ]; then
        orig="$("$PATCHELF" --print-rpath "$f.orig" 2>/dev/null || true)"
      fi
      [ -n "$orig" ] || orig='$ORIGIN'
      printf '%s:%s' "$orig" "$SYMLINK_DIR"
    }

    # Directories where the Editor's sub-binaries and .so files live (a whole-
    # tree scan is slow; these cover the Package Manager, Licensing, and build
    # tools).
    SEARCH_DIRS=("$EDITOR_DIR" "$EDITOR_DIR/Data/Resources" "$EDITOR_DIR/Data/Tools" \
      "$EDITOR_DIR/Data/MonoBleedingEdge" "$EDITOR_DIR/Data/NetCoreRuntime" \
      "$EDITOR_DIR/Data/netcorerun" "$EDITOR_DIR/Data/il2cpp" \
      "$EDITOR_DIR/Data/PlaybackEngines")

    patched=0 refreshed=0 libpatched=0 libskipped=0
    while read -r f; do
      case "$f" in
        *.so*|*.debug|*.pdb|*.dll|*.orig|*.a|*.txt|*.json|*.xml|*.html|*.meta|*.cs \
        |*.bytes|*.asset|*.prefab|*.mat|*.png|*.jpg|*.jpeg|*.ttf|*.otf|*.wav|*.mp3 \
        |*.ogg|*.lic|*.snk|*.config|*.manifest) continue ;;
      esac
      interp="$(readelf -p .interp "$f" 2>/dev/null | grep -oE '/[^ ]+' | head -1 || true)"
      [ -n "$interp" ] || continue
      case "$interp" in
        /nix/store/*glibc-*)
          # Already patched; refresh the RPATH (original rpath + libs dir).
          "$PATCHELF" --set-rpath "$(rpath_for "$f")" "$f"
          refreshed=$((refreshed+1))
          continue ;;
      esac
      # Not yet patched: back up the original (once), set interpreter + RPATH.
      [ -f "$f.orig" ] || cp -p "$f" "$f.orig"
      "$PATCHELF" --set-interpreter "$GLIBC_LD" "$f"
      "$PATCHELF" --set-rpath "$(rpath_for "$f")" "$f"
      patched=$((patched+1))
    done < <(find "''${SEARCH_DIRS[@]}" -type f 2>/dev/null)

    # Pass 2: .so files (RPATH only).
    while read -r f; do
      case "$f" in *.orig|*.debug|*.pdb) continue ;; esac
      [ "$(od -An -tu1 -j4 -N1 "$f" 2>/dev/null | tr -d ' ')" = "2" ] || continue
      head -c 4 "$f" 2>/dev/null | od -An -tx1 | grep -q "7f 45 4c 46" || continue
      cur="$("$PATCHELF" --print-rpath "$f" 2>/dev/null || true)"
      case "$cur" in
        *"$SYMLINK_DIR"*) libskipped=$((libskipped+1)); continue ;;
      esac
      [ -n "$cur" ] && new_rpath="$cur:$SYMLINK_DIR" || new_rpath="$SYMLINK_DIR"
      "$PATCHELF" --set-rpath "$new_rpath" "$f" 2>/dev/null || continue
      libpatched=$((libpatched+1))
    done < <(find "''${SEARCH_DIRS[@]}" -type f \( -name "*.so" -o -name "*.so.*" \) 2>/dev/null)

    echo "unity-editor-patchelf: done (exec patched=$patched rpath-refreshed=$refreshed; .so patched=$libpatched skipped=$libskipped)"
  '';
in
pkgs.stdenvNoCC.mkDerivation {
  pname = "unity-cli";
  inherit version;

  src = pkgs.fetchurl {
    url = "https://public-cdn.cloud.unity3d.com/hub/prod/cli/${version}/unity-linux-x64";
    inherit sha256;
  };

  dontConfigure = true;
  dontBuild = true;
  # src is a single pre-built binary (not an archive) — skip unpacking so
  # $src is the file itself.
  dontUnpack = true;

  nativeBuildInputs = [ pkgs.patchelf ];

  installPhase = ''
    # The CLI (patchelf'd in fixupPhase below).
    install -Dm755 "$src" "$out/bin/unity"

    # The Editor launcher + patchelf script. The __UNITY_EDITOR_LIBS__
    # placeholder is replaced with this package's own lib/unity-editor-libs
    # store path, so the scripts are self-contained (they reference the libs
    # dir that ships in the same package).
    mkdir -p "$out/bin"
    sed "s|__UNITY_EDITOR_LIBS__|$out/lib/unity-editor-libs|g" \
      "${unityEditorLauncher}" > "$out/bin/unity-editor"
    sed "s|__UNITY_EDITOR_LIBS__|$out/lib/unity-editor-libs|g" \
      "${unityEditorPatchelf}" > "$out/bin/unity-editor-patchelf"
    chmod +x "$out/bin/unity-editor" "$out/bin/unity-editor-patchelf"

    # The system libs the Editor needs, as a single symlink dir. The Editor's
    # binaries get this dir appended to their RPATH (by unity-editor-patchelf),
    # so the loader resolves libX.so -> store lib at runtime. A single short
    # path keeps the RPATH small (listing every store lib dir would overflow
    # patchelf's shiftFile).
    mkdir -p "$out/lib/unity-editor-libs"
    ${lib.concatStringsSep "\n" (map (l: "ln -sf '${l.src}' \"$out/lib/unity-editor-libs/${l.name}\"") unityLibs)}
  '';

  # Make the pre-built CLI binary runnable on NixOS: point its interpreter and
  # RPATH at the store's glibc + libgcc (the system /lib64 loader is a stub
  # that refuses generic dynamically-linked binaries).
  fixupPhase = ''
    ${pkgs.patchelf}/bin/patchelf \
      --set-interpreter ${pkgs.glibc}/lib/ld-linux-x86-64.so.2 \
      --set-rpath "${pkgs.glibc}/lib:${pkgs.glibc}/lib64:${pkgs.libgcc}/lib" \
      "$out/bin/unity"
  '';

  meta = with lib; {
    description = "Unity command-line interface (official) + NixOS support for the in-place Unity Editor";
    homepage = "https://unity.com";
    license = licenses.unfree;
    platforms = [ "x86_64-linux" ];
    mainProgram = "unity";
  };
}
